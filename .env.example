# ==============================================================
# CampusPulse - Environment Configuration Template
# Copy this file to .env.local and update with your own values
# ==============================================================

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/campuspulse?retryWrites=true&w=majority

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=campus_pulse_jwt_secret_key_2026_production_safe

# Application JWT Secret (used for token signing & verification)
JWT_SECRET=campuspulse_jwt_secret_key_2026_production_safe

# Local Media Upload Directory (public/uploads)
UPLOAD_DIR=./public/uploads

# Mobile (Capacitor) & Production Web URL
APP_URL=http://localhost:3000
